<div class="card">
  <h2>All Registrations</h2>
  <p class="subtitle">Temporarily stored in server memory</p>
  <div class="divider"></div>

  <% if (registrations.length === 0) { %>
    <div class="empty-state">No registrations yet.</div>
  <% } else { %>
    <table class="reg-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Course</th>
          <th>Submitted At</th>
        </tr>
      </thead>
      <tbody>
        <% registrations.forEach((r, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><%= r.name %></td>
            <td><%= r.email %></td>
            <td><%= r.phone %></td>
            <td><%= r.course %></td>
            <td><%= r.submittedAt %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <div class="link-row">
    <a href="/">← Back to Form</a>
  </div>
</div>
