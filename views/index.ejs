<div class="card">
  <h2>Create Account</h2>
  <p class="subtitle">Fill in the details below to register</p>
  <div class="divider"></div>

  <% if (errors && errors.length > 0) { %>
    <ul class="error-box">
      <% errors.forEach(e => { %>
        <li>⚠️ <%= e %></li>
      <% }); %>
    </ul>
  <% } %>

  <form onsubmit="return validateForm()" method="POST" action="/submit">

    <div class="form-row">
      <div class="form-group">
        <label>Full Name</label>
        <input type="text" id="name" name="name" placeholder="John Doe">
      </div>
      <div class="form-group">
        <label>Phone Number</label>
        <input type="text" id="phone" name="phone" placeholder="10 digits">
      </div>
    </div>

    <div class="form-group">
      <label>Email Address</label>
      <input type="email" id="email" name="email" placeholder="you@example.com">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Password</label>
        <input type="password" id="password" name="password" placeholder="Min 6 chars">
      </div>
      <div class="form-group">
        <label>Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter">
      </div>
    </div>

    <div class="form-group">
      <label>Gender</label>
      <div class="radio-group">
        <label><input type="radio" name="gender" value="Male"> Male</label>
        <label><input type="radio" name="gender" value="Female"> Female</label>
        <label><input type="radio" name="gender" value="Other"> Other</label>
      </div>
    </div>

    <div class="form-group">
      <label>Course</label>
      <select id="course" name="course">
        <option value="">-- Select Course --</option>
        <option value="Web Development">Web Development</option>
        <option value="Data Science">Data Science</option>
        <option value="AI/ML">AI/ML</option>
        <option value="Cybersecurity">Cybersecurity</option>
      </select>
    </div>

    <div class="checkbox-group">
      <input type="checkbox" id="terms" name="terms">
      <label for="terms">I agree to the Terms and Conditions</label>
    </div>

    <button type="submit" class="btn-submit">Create Account →</button>

  </form>
</div>
