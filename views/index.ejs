<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Registration - Server Rendering</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <div class="card">
      <div class="card-header">
        <h2>Student Registration Form</h2>
        <p>Task 1: HTML Structure and Basic Server Interaction</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error">
          <p><%= error %></p>
        </div>
      <% } %>

      <form action="/submit" method="POST" class="registration-form">
        <div class="form-group">
          <label for="name">Full Name:</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            value="<%= formData && formData.name ? formData.name : '' %>"
            placeholder="Enter your name" 
            required
          >
        </div>

        <div class="form-group">
          <label for="email">Email:</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            value="<%= formData && formData.email ? formData.email : '' %>"
            placeholder="Enter your email" 
            required
          >
        </div>

        <div class="form-group">
          <label for="age">Age:</label>
          <input 
            type="number" 
            id="age" 
            name="age" 
            value="<%= formData && formData.age ? formData.age : '' %>"
            placeholder="Enter your age" 
            min="1" 
            max="120"
            required
          >
        </div>

        <div class="form-group">
          <label for="course">Course:</label>
          <select id="course" name="course" required>
            <option value="" disabled <%= !formData || !formData.course ? 'selected' : '' %>>Select Course</option>
            <option value="B.E. Electronics and Communication Engineering" <%= formData && formData.course === 'B.E. Electronics and Communication Engineering' ? 'selected' : '' %>>B.E. Electronics and Communication Engineering</option>
            <option value="B.E. Computer Science and Engineering" <%= formData && formData.course === 'B.E. Computer Science and Engineering' ? 'selected' : '' %>>B.E. Computer Science and Engineering</option>
            <option value="B.Tech Information Technology" <%= formData && formData.course === 'B.Tech Information Technology' ? 'selected' : '' %>>B.Tech Information Technology</option>
            <option value="B.E. Mechanical Engineering" <%= formData && formData.course === 'B.E. Mechanical Engineering' ? 'selected' : '' %>>B.E. Mechanical Engineering</option>
            <option value="B.E. Electrical and Electronics Engineering" <%= formData && formData.course === 'B.E. Electrical and Electronics Engineering' ? 'selected' : '' %>>B.E. Electrical and Electronics Engineering</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Submit Registration</button>
      </form>
    </div>
  </div>
</body>
</html>
