<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Registration Success</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <div class="card">
    <h2>✅ Registration Successful</h2>

    <table style="width:100%; border-collapse: collapse; margin-top: 16px;">
      <tr><td><strong>Name</strong></td><td><%= name %></td></tr>
      <tr><td><strong>Email</strong></td><td><%= email %></td></tr>
      <tr><td><strong>Phone</strong></td><td><%= phone %></td></tr>
      <tr><td><strong>Gender</strong></td><td><%= gender %></td></tr>
      <tr><td><strong>Course</strong></td><td><%= course %></td></tr>
      <tr><td><strong>Submitted At</strong></td><td><%= submittedAt %></td></tr>
    </table>

    <p style="margin-top: 16px; color: #555;">
      Total registrations so far: <strong><%= total %></strong>
    </p>

    <a href="/" style="display:inline-block; margin-top:12px;">← Register Another</a>
    <a href="/registrations" style="display:inline-block; margin-top:12px; margin-left:16px;">View All Registrations</a>
  </div>

</body>
</html>
